{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "class1forever",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-03-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "kv_namespaces": [
    {
      "binding": "CLASS_MAP_DATA",
      "id": "e6c9c4ff9bc84aa4979184515e713ecb",
      "preview_id": "2761c6566ea945c2ac44da3a916cb840",
      "remote": true
    }
  ],
  "secrets": {
    "required": ["DETAILS_PASSPHRASE", "DETAILS_SESSION_SECRET"]
  },
  "vars": {
    "DETAILS_HINT": "语文老师的姓名拼音（例：张三就输入“zhangsan”）"
  },
  "env": {
    "preview": {
      "kv_namespaces": [
        {
          "binding": "CLASS_MAP_DATA",
          "id": "2761c6566ea945c2ac44da3a916cb840"
        }
      ],
      "vars": {
        "DETAILS_HINT": "语文老师的姓名拼音（例：张三就输入“zhangsan”）"
      }
    }
  }
}
