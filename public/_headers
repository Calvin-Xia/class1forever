/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/fonts/subsets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/dm-serif-display.7e6679d41e35.woff2
  Cache-Control: public, max-age=31536000, immutable

/deployment-assets.json
  Cache-Control: no-store
