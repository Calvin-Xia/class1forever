---
/**
 * 地图区：图框、工具栏、分享按钮、缩放控件、比例尺、地图容器与版权署名。
 *
 * 这里只有静态结构；ECharts 实例的挂载、下钻、缩放夹紧与悬浮卡片归 l2_map（见 src/scripts/map-island-boot.ts），
 * 按钮的磁吸 / 聚光位移归 l2_motion（`magnet` / `spotlight` 类就是给它们的钩子）。
 */
import Icon from './Icon.astro';
---

<section class="map-section" aria-label="互动地图">
    <div class="map-container">
        <div class="map-frame">
            <div class="map-frame__corner map-frame__corner--tl" aria-hidden="true"></div>
            <div class="map-frame__corner map-frame__corner--tr" aria-hidden="true"></div>
            <div class="map-frame__corner map-frame__corner--bl" aria-hidden="true"></div>
            <div class="map-frame__corner map-frame__corner--br" aria-hidden="true"></div>

            <div class="map-toolbar">
                <button id="map-back-btn" class="chip map-back-btn" type="button" hidden>
                    <Icon name="arrow-left" size="sm" />
                    <span>返回全国</span>
                </button>
                <span id="map-region-badge" class="chip map-region-badge">中国</span>
            </div>

            <button
                id="share-btn"
                class="share-btn magnet spotlight"
                type="button"
                title="保存分享图"
                aria-label="保存分享图"
            >
                <Icon name="share" size="md" />
            </button>

            <div class="map-zoom" role="group" aria-label="地图缩放">
                <button
                    id="map-zoom-in"
                    class="map-zoom__btn"
                    type="button"
                    aria-label="放大地图"
                    title="放大"
                >
                    <Icon name="plus" size="sm" />
                </button>
                <button
                    id="map-zoom-out"
                    class="map-zoom__btn"
                    type="button"
                    aria-label="缩小地图"
                    title="缩小"
                >
                    <Icon name="minus" size="sm" />
                </button>
                <button
                    id="map-zoom-reset"
                    class="map-zoom__btn"
                    type="button"
                    aria-label="重置地图缩放，回到铺满视图"
                    title="重置视图"
                >
                    <Icon name="frame-reset" size="sm" />
                </button>
            </div>

            <div class="map-scale" aria-hidden="true">
                <span class="map-scale__bar"></span>
                <span class="map-scale__label">200 km</span>
            </div>

            <!-- 地图容器只留给 ECharts。加载层**不能**再放回这里面：zrender 的 Painter 在
                 init 时会 `root.innerHTML = ''`（zrender/lib/canvas/Painter.js:114），
                 任何静态子节点会在那一刻被删掉 —— 加载文案与转圈就是这么变成「从不可见」的。
                 role=img 需要 aria-label；忙碌状态靠容器自己的 aria-busy 与页脚那条
                 role=status 的播报承担。 -->
            <div
                id="map"
                role="img"
                aria-label="中国地图，显示同学分布"
                aria-busy="true"
                tabindex="-1"
            ></div>

            <!-- 地图加载态（「正在展开图面…」/「正在加载 X 地图…」+ 转圈）。
                 它是 .map-frame 的直接子元素、#map 的兄弟：`.map-loading` 是
                 position:absolute; inset:0; z-index:50，在 .map-frame（relative + overflow:hidden）
                 里的几何与层叠和以前挂在 #map 里完全一致（#map 有 1px 边框差，视觉不可见），
                 可见时按默认 pointer-events 吸收点击 —— 加载期间点不到 canvas，是旧站原意。
                 aria-hidden="true" 是硬要求：离开 role="img" 容器后它会重新进入无障碍树，
                 会和 #map[aria-busy]、页脚 role=status 重复播报；本次只让它可见，不改读屏语义。
                 map-island 的 showProvinceLoading / hideMapLoading 与 scripts/map-fatal-error.ts
                 都按 id 找它，与 DOM 位置无关。 -->
            <div id="map-loading" class="map-loading" aria-hidden="true">
                <div class="map-loading__spinner"></div>
                <p class="map-loading__text">正在展开图面…</p>
            </div>

            <!-- 触摸按压反馈环（l2_map 的 tap-fallback 写它）：
                 按住 300ms 命中一个地区时设 data-visible="true" 并写 style.left / top
                 （相对 .map-frame padding box 的 px），touchend / touchcancel / 超时后
                 置回 data-visible="false"。纯视觉反馈，所以 aria-hidden，
                 样式见 main.css 的 .map-press-ring。 -->
            <div id="map-press-ring" class="map-press-ring" aria-hidden="true" data-visible="false"></div>

            <!-- 地图岛屿（l2_map）：入口是 src/scripts/map-island-boot.ts；
                 分享图与读屏播报（l2_share）挂在同一条入口上（src/scripts/share-boot.ts），
                 它的两个挂载点分别在本区的 #share-btn 与页脚的 #interaction-note。
                 不用 `client:only` 是因为 Astro 岛屿水合会注入**内联** script，
                 被 `_headers` 的 `script-src 'self'` 拦下（实测两个内联脚本被拒）。
                 用动态 import 让 Astro 产出外链 chunk，CSP 下才能正常加载。

                 本段 script 标签会被 Astro 编成**入口 chunk**，页面一定会执行到它，
                 所以「资源加载失败」的兜底必须写在这里（#11）：
                 岛屿是动态 import 挂载的，chunk 拿不到时那边的兜底代码根本不会跑，
                 「重新加载」按钮就成了死链。只静态引用 map-fatal-error（零依赖的小模块），
                 不把 ECharts / 几何数据拖进入口 chunk。 -->
            <script>
                import { revealMapFatalError } from '../scripts/map-fatal-error';

                const MAP_CHUNK_LOAD_FAILED = '地图脚本加载失败，请检查网络连接后重新加载。';

                // 绑定放在入口 chunk：面板由谁显示（岛屿崩了 / chunk 404 / 预加载失败）都能点。
                document.getElementById('cdn-error-retry')?.addEventListener('click', () => {
                    window.location.reload();
                });

                // 这里刻意**不**监听 window 的 `vite:preloadError`：那个事件对页面上每个动态
                // import 都会派发（含 BaseLayout 的动效、本区的分享），而 #cdn-error 是 z-index
                // 全屏面板且只显示不收起 —— 动效 chunk 失败就会把还能用的地图挡在重载面板后面。
                // 必需的 chunk 用下面各自的 `.catch` 精确兜底即可：Vite 的预加载 helper 在派发
                // 事件之后仍会抛出 rejection（所以不能在里面 preventDefault），`.catch` 拿得到。
                import('../scripts/map-island-boot').catch(() => {
                    revealMapFatalError(MAP_CHUNK_LOAD_FAILED);
                });

                // 分享是附加能力：失败不能静默，但也不能盖住地图。把按钮标成不可用，并在页脚
                // 的播报位说明（分享岛屿没加载，所以不会有别的代码来写这个位置）。
                import('../scripts/share-boot').catch(() => {
                    console.error('Share island failed to load.');
                    const button = document.getElementById('share-btn');
                    if (button instanceof HTMLButtonElement) {
                        button.disabled = true;
                        button.title = '分享功能未能加载，请刷新页面重试';
                        button.setAttribute('aria-label', '分享功能未能加载，请刷新页面重试');
                    }
                    const note = document.getElementById('interaction-note');
                    if (note) {
                        note.textContent = '分享功能未能加载，请刷新页面重试。';
                    }
                });
            </script>

            <a
                href="https://echarts.apache.org"
                target="_blank"
                rel="noopener noreferrer"
                class="map-credit">Apache ECharts</a
            >
        </div>
    </div>
</section>
